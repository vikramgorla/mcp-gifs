{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-gifs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Deploys to the default https://mcp-gifs.<your-subdomain>.workers.dev (no custom domain/DNS).
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "CACHE_TTL_SECONDS": "600" },
  // RATE_LIMITER: 60 MCP POSTs per IP per 60s, per location.
  // GLOBAL_RATE_LIMITER: 25 MCP requests per 60s on a constant key, per location.
  // 25 is conservative because counters are per-location (see docs/DECISIONS.md).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4711", "simple": { "limit": 60, "period": 60 } },
    { "name": "GLOBAL_RATE_LIMITER", "namespace_id": "4712", "simple": { "limit": 25, "period": 60 } }
  ]
}
